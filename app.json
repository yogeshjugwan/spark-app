{
  "expo": {
    "name": "Spark",
    "slug": "dating-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "datingapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "app.spark.dating"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCE9FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS",
        "VIBRATE",
        "USE_FULL_SCREEN_INTENT"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ],
      "package": "app.spark.dating"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1ECF4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Spark uses your photos so you can add them to your dating profile.",
          "cameraPermission": "Spark uses the camera so you can take profile photos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Spark uses the microphone to record your voice intro and voice messages."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Spark uses your approximate location to show people near you."
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Spark uses the camera for video calls with your matches.",
          "microphonePermission": "Spark uses the microphone for calls and voice messages."
        }
      ],
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "color": "#E063B2",
          "defaultChannel": "messages"
        }
      ],
      "expo-video",
      [
        "expo-contacts",
        {
          "contactsPermission": "Spark lets you share a contact in chat."
        }
      ],
      "expo-document-picker",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
